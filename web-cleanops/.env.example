# =============================================================================
# .env.example — web-cleanops
# =============================================================================
# Copy to .env (or .env.local) and fill in real values.
# .env / .env.local are git-ignored — never commit secrets.
#
# Most flags are optional. The app runs entirely on localStorage when Supabase
# env vars are missing — it degrades gracefully. To enable Supabase-backed
# features, set the two Supabase connection vars below.
# =============================================================================

# ── Supabase Connection ────────────────────────────────────────────────────
# Required for Supabase Auth, database read/write, and edge-function calls.
# Without these, the app operates in localStorage-only mode.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Auth ──────────────────────────────────────────────────────────────────
# Supabase Auth (PKCE) — authoritative-ON in real app builds.
# Set to "false" for instant, data-free rollback to localStorage-only auth.
# EXPO_PUBLIC_USE_SUPABASE_AUTH=false

# Unlocks the Super Admin "Create User" screen for inviting Supabase users.
# Default OFF. Set to "true" to enable.
# EXPO_PUBLIC_ENABLE_USER_CREATION=true

# ── Feature Flags — Rollback Switches ─────────────────────────────────────
# Each of these is authoritative-ON by default in production builds
# (Supabase is the primary data store). Set any to "false" for an instant,
# data-free rollback to localStorage authority for that area.
#
# Core operational domains
# EXPO_PUBLIC_CUSTOMERS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_WORK_ORDERS_LIST_SUPABASE_READ=false
# EXPO_PUBLIC_WORK_ORDERS_DUAL_WRITE=false
# EXPO_PUBLIC_SCHEDULE_SUPABASE_AUTHORITATIVE=false
#
# Directory domains (employees, teams, services, geography)
# EXPO_PUBLIC_EMPLOYEES_SUPABASE_READ=false
# EXPO_PUBLIC_TEAMS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_SERVICES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_SERVICE_CATEGORIES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_PAYROLL_GROUPS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_SERVICE_PACKAGES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_AREAS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_POSTAL_CITIES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_EMPLOYEE_LANGUAGES_SUPABASE_AUTHORITATIVE=false
#
# Operational / identity / scheduling
# EXPO_PUBLIC_VISIT_OCCURRENCES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_ROLES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_USERS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_TIME_CODES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_BOOKING_QUEUE_SUPABASE_AUTHORITATIVE=false
#
# Settings, content, entitlements, audit
# EXPO_PUBLIC_SETTINGS_TEMPLATES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_COMPANY_SETTINGS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_MODULES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_CHECKLIST_TEMPLATES_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_CUSTOMER_PROTOCOLS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_MEDIA_ASSETS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_ENTITLEMENTS_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_ACTIVITY_LOG_SUPABASE_AUTHORITATIVE=false
# EXPO_PUBLIC_SYSTEM_SETTINGS_SUPABASE_AUTHORITATIVE=false

# ── Feature Flags — Granular Opt-Ins ──────────────────────────────────────
# All default OFF. Enable any one independently to migrate a specific
# read or write path to Supabase without flipping the full cutover.
# Set to "true" to enable.
#
# Customers (Wave 1)
# EXPO_PUBLIC_USE_SUPABASE_COMPANIES=true
# EXPO_PUBLIC_CUSTOMERS_LIST_SUPABASE_READ=true
# EXPO_PUBLIC_CUSTOMERS_DETAIL_SUPABASE_READ=true
# EXPO_PUBLIC_CUSTOMERS_DUAL_WRITE=true
#
# Work Orders (Wave 2)
# EXPO_PUBLIC_WORK_ORDERS_DETAIL_SUPABASE_READ=true
# EXPO_PUBLIC_WORK_ORDERS_SUPABASE_AUTHORITATIVE=true
#
# Schedule (Wave 3)
# EXPO_PUBLIC_SCHEDULE_SUPABASE_INTERVAL_READ=true
#
# Employees
# EXPO_PUBLIC_EMPLOYEES_DUAL_WRITE=true
# EXPO_PUBLIC_EMPLOYEES_SHADOW_VALIDATE=true
#
# Teams
# EXPO_PUBLIC_TEAMS_SUPABASE_READ=true
# EXPO_PUBLIC_TEAMS_DUAL_WRITE=true
#
# Services
# EXPO_PUBLIC_SERVICES_SUPABASE_READ=true
# EXPO_PUBLIC_SERVICES_DUAL_WRITE=true
#
# Service Catalog
# EXPO_PUBLIC_SERVICE_CATEGORIES_SUPABASE_READ=true
# EXPO_PUBLIC_SERVICE_CATEGORIES_DUAL_WRITE=true
# EXPO_PUBLIC_SERVICE_PACKAGES_SUPABASE_READ=true
# EXPO_PUBLIC_SERVICE_PACKAGES_DUAL_WRITE=true
#
# Payroll Groups
# EXPO_PUBLIC_PAYROLL_GROUPS_SUPABASE_READ=true
# EXPO_PUBLIC_PAYROLL_GROUPS_DUAL_WRITE=true
#
# Areas / Geography
# EXPO_PUBLIC_AREAS_SUPABASE_READ=true
# EXPO_PUBLIC_AREAS_DUAL_WRITE=true
# EXPO_PUBLIC_POSTAL_CITIES_SUPABASE_READ=true
# EXPO_PUBLIC_POSTAL_CITIES_DUAL_WRITE=true
# EXPO_PUBLIC_EMPLOYEE_LANGUAGES_SUPABASE_READ=true
# EXPO_PUBLIC_EMPLOYEE_LANGUAGES_DUAL_WRITE=true
#
# Missions / Visit Occurrences
# EXPO_PUBLIC_VISIT_OCCURRENCES_SUPABASE_READ=true
# EXPO_PUBLIC_VISIT_OCCURRENCES_DUAL_WRITE=true
#
# Roles & Users
# EXPO_PUBLIC_ROLES_SUPABASE_READ=true
# EXPO_PUBLIC_ROLES_DUAL_WRITE=true
# EXPO_PUBLIC_USERS_SUPABASE_READ=true
# EXPO_PUBLIC_USERS_DUAL_WRITE=true
#
# Time Codes
# EXPO_PUBLIC_TIME_CODES_SUPABASE_READ=true
# EXPO_PUBLIC_TIME_CODES_DUAL_WRITE=true
#
# Booking Queue
# EXPO_PUBLIC_BOOKING_QUEUE_SUPABASE_READ=true
# EXPO_PUBLIC_BOOKING_QUEUE_DUAL_WRITE=true
# EXPO_PUBLIC_BOOKING_QUEUE_LOCAL_BACKOUT_BRIDGE=true
#
# Settings
# EXPO_PUBLIC_SETTINGS_TEMPLATES_SUPABASE_READ=true
# EXPO_PUBLIC_SETTINGS_TEMPLATES_DUAL_WRITE=true
# EXPO_PUBLIC_COMPANY_SETTINGS_SUPABASE_READ=true
# EXPO_PUBLIC_COMPANY_SETTINGS_DUAL_WRITE=true
#
# Modules & Content
# EXPO_PUBLIC_MODULES_SUPABASE_READ=true
# EXPO_PUBLIC_MODULES_DUAL_WRITE=true
# EXPO_PUBLIC_CHECKLIST_TEMPLATES_SUPABASE_READ=true
# EXPO_PUBLIC_CHECKLIST_TEMPLATES_DUAL_WRITE=true
# EXPO_PUBLIC_CUSTOMER_PROTOCOLS_SUPABASE_READ=true
# EXPO_PUBLIC_CUSTOMER_PROTOCOLS_DUAL_WRITE=true
# EXPO_PUBLIC_MEDIA_ASSETS_SUPABASE_READ=true
# EXPO_PUBLIC_MEDIA_ASSETS_DUAL_WRITE=true
#
# Entitlements
# EXPO_PUBLIC_ENTITLEMENTS_SUPABASE_READ=true
# EXPO_PUBLIC_ENTITLEMENTS_DUAL_WRITE=true
#
# Activity Log
# EXPO_PUBLIC_ACTIVITY_LOG_SUPABASE_READ=true
# EXPO_PUBLIC_ACTIVITY_LOG_DUAL_WRITE=true
#
# System Settings
# EXPO_PUBLIC_SYSTEM_SETTINGS_SUPABASE_READ=true
# EXPO_PUBLIC_SYSTEM_SETTINGS_DUAL_WRITE=true
#
# Mission Log (schema-only — no runtime behaviour wired yet)
# EXPO_PUBLIC_MISSION_LOG_SUPABASE_READ=true
# EXPO_PUBLIC_MISSION_LOG_DUAL_WRITE=true
# EXPO_PUBLIC_MISSION_LOG_SUPABASE_AUTHORITATIVE=true
#
# Time Reporting (schema-only — no runtime behaviour wired yet)
# EXPO_PUBLIC_TIME_REPORTING_SUPABASE_READ=true
# EXPO_PUBLIC_TIME_REPORTING_DUAL_WRITE=true
# EXPO_PUBLIC_TIME_REPORTING_AUTHORITATIVE=true
# EXPO_PUBLIC_TIME_REPORTING_SHADOW_VALIDATE=true
#
# Request CRM (frontend shell with mock data)
# EXPO_PUBLIC_ENABLE_REQUEST_CRM_FRONTEND_SHELL=true
# EXPO_PUBLIC_ENABLE_REQUEST_CRM_SETTINGS_SHELL=true
# EXPO_PUBLIC_ENABLE_REQUEST_CRM_AUTOMATION_QUICK_REVIEW=true

# ── Edge-Function Secrets ─────────────────────────────────────────────────
# THESE ARE PRIVATE — set them in your Supabase dashboard as Edge Function
# secrets, NEVER in .env or .env.local. Listed here for documentation only.
#
# Required by admin-create-user, admin-delete-user, admin-user-lifecycle,
# and public-calculator:
#   SUPABASE_URL               = https://<your-project>.supabase.co
#   SUPABASE_ANON_KEY           = eyJhbGciOi...
#   SUPABASE_SERVICE_ROLE_KEY   = eyJhbGciOi...  ⚠ never expose in browser
#
# Required by admin-create-user for bootstrap (first super-admin creation):
#   BOOTSTRAP_SUPER_ADMIN_EMAIL = first-admin@example.com
#   BOOTSTRAP_SUPER_ADMIN_TOKEN = <cryptographically-random-token>
#
# Optional invite redirect for admin-create-user:
#   INVITE_REDIRECT_URL         = https://yourapp.com/auth/callback
