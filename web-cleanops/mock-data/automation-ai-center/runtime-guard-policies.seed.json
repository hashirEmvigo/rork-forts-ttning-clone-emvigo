[
  {
    "id": "rgp_001",
    "key": "runtime.guard.booking_list_frontend_loop",
    "name": "Booking List frontend loop guard",
    "description": "Detects abnormal repeated Booking List reads from one browser session and applies session-level protection without degrading the full platform.",
    "module": "schedule",
    "scope": "session",
    "triggerType": "frontend_loop_detected",
    "conditions": [
      {
        "key": "request_count_over_session_threshold",
        "description": "Session exceeds Booking List read threshold inside the configured time window.",
        "type": "threshold",
        "config": { "limitKey": "schedule.booking_list.session_read_limit" }
      }
    ],
    "riskLevel": "high",
    "guardActions": ["throttle", "quarantine_session", "create_incident"],
    "safetyLimitKeys": ["schedule.booking_list.session_read_limit"],
    "runtimeFlagKey": "feature.booking_list.auto_refresh",
    "circuitBreakerKey": null,
    "incidentPolicy": {
      "createIncident": true,
      "updateExisting": true,
      "dedupeWindowSeconds": 900,
      "severity": "high"
    },
    "alertPolicy": {
      "alertTargets": ["dev_team"],
      "alertOnSeverities": ["high", "critical"],
      "createFollowUpTask": true,
      "followUpOwner": "schedule_team"
    },
    "resolutionPolicy": {
      "requiredForSeverities": ["high", "critical"],
      "requiresResolutionNotes": true,
      "requiresRegressionCheck": true,
      "rollbackPlanRequired": true
    },
    "status": "planned",
    "createdAt": "2026-06-11T12:00:00Z",
    "updatedAt": "2026-06-11T12:00:00Z"
  },
